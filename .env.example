# ============================================================
# LLMark 环境变量配置模板
# ============================================================
# 复制此文件为 .env 并填入实际值
# cp .env.example .env
#
# SDK 用户也可使用全局配置：~/.config/llmark/config.env
# ============================================================

# ============ 后端 (FastAPI) ============
DATABASE_URL=postgresql://llmark:llmark_password@127.0.0.1:5432/llmark
REDIS_URL=redis://127.0.0.1:6380/0
CACHE_TTL_SECONDS=300
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
JWT_SECRET=replace_me_with_a_long_random_secret
JWT_EXPIRE_DAYS=30
FRONTEND_URL=http://localhost:3011
CORS_ALLOWED_ORIGINS=
SESSION_COOKIE_SECURE=false
ENV=development

# ============ 前端 (Next.js) ============
NEXT_PUBLIC_API_URL=http://127.0.0.1:8011/v1

# ============ SDK ============
LLMARK_ENABLED=true
LLMARK_API_URL=http://127.0.0.1:8011/v1/report
LLMARK_SAMPLE_RATE=1.0
LLMARK_DEBUG=false
LLMARK_LOG_FILE=false
